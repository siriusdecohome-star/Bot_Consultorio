# Copiar este archivo a .env y completar. El archivo .env NO se sube al repositorio.

# --- Proveedor de IA: claude | openai | mock (mock funciona sin clave) ---
LLM_PROVIDER=mock

# Claude (Anthropic) — clave en https://console.anthropic.com
# Si LLM_PROVIDER=claude y la clave está vacía, el bot pasa solo al modo sin IA (mock)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high (para un chat corto, low es más rápido y barato)
CLAUDE_EFFORT=low
# Precios USD por millón de tokens: vacío = se toman según CLAUDE_MODEL (Opus/Sonnet/Haiku 5.5)
CLAUDE_PRICE_INPUT_PER_MTOK=
CLAUDE_PRICE_OUTPUT_PER_MTOK=
CLAUDE_PRICE_CACHE_READ_PER_MTOK=

# OpenAI — clave en https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Completar con los precios vigentes de OpenAI
OPENAI_PRICE_INPUT_PER_MTOK=0
OPENAI_PRICE_OUTPUT_PER_MTOK=0

# --- Consultorio ---
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires
SLOT_MINUTES=30
PORT=3000

# --- Supabase (ver docs/guia-cuentas-supabase-google.md) ---
# Si quedan vacías, el bot usa una base en memoria.
SUPABASE_URL=
# Clave SECRETA (sb_secret_... o la legacy service_role). Solo backend.
SUPABASE_SECRET_KEY=
# Clave PÚBLICA (sb_publishable_...): la usa el login del panel (Supabase Auth).
SUPABASE_PUBLISHABLE_KEY=

# --- Google Calendar (ver docs/guia-cuentas-supabase-google.md) ---
# Si queda vacía, el bot usa una agenda en memoria.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=secrets/google-service-account.json

# --- WhatsApp Cloud API (ver docs/guia-meta-whatsapp.md) ---
# Si quedan vacías, solo funciona el simulador web.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# «Identificador de la cuenta de mensajes» (WABA), para npm run wa:subscribe
WHATSAPP_WABA_ID=
# Texto inventado (largo y al azar); se pega igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app → Básica → Clave secreta de la app
WHATSAPP_APP_SECRET=
# La versión que muestra el ejemplo curl de Meta en "Paso 1. Probar"
WHATSAPP_GRAPH_VERSION=v25.0

# Límite de mensajes del simulador web por IP cada 10 minutos
WEB_MAX_MSGS_PER_10MIN=40

# Aviso de privacidad: inline (una línea en el saludo) | separate (mensaje aparte) | off
PRIVACY_NOTICE=inline

# Recordatorios
REMINDERS_ENABLED=true
REMINDERS_INTERVAL_SEC=60
FOLLOWUP_AFTER_HOURS=20
WHATSAPP_TEMPLATE_REMINDER=recordatorio_turno
WHATSAPP_TEMPLATE_FOLLOWUP=seguimiento_promo
WHATSAPP_TEMPLATE_WAITLIST=turno_liberado
WHATSAPP_TEMPLATE_REACTIVATION=reactivacion_paciente
WHATSAPP_TEMPLATE_RESCHEDULE=turno_reprogramar
WHATSAPP_TEMPLATE_POST_VISIT=seguimiento_post_turno
WHATSAPP_TEMPLATE_LANG=es

# Lista de espera: minutos que se guarda un horario liberado antes de ofrecerlo a la siguiente persona
WAITLIST_OFFER_MINUTES=30
# Bandeja: horas sin mensajes para cerrar una conversación (se reabre si el paciente vuelve a escribir)
CONVERSATION_IDLE_HOURS=24
# Reactivación: invitar a un control a quien no viene hace N meses (máx. por revisión)
REACTIVATION_ENABLED=true
REACTIVATION_MONTHS=6
REACTIVATION_MAX_PER_SWEEP=5

# Panel del consultorio (/panel): usuarios ficticios con roles admin y recepción.
# npm run seed:users completa estas variables (y crea los usuarios en Supabase Auth).
PANEL_SESSION_SECRET=
DEMO_PASS_ADMIN_SONRISA=
DEMO_PASS_RECEPCION_SONRISA=
DEMO_PASS_ADMIN_ALTAMIRA=
DEMO_PASS_RECEPCION_ALTAMIRA=
