{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{public,private,docs/ejemplos}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
